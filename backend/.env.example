# Bayesline Configuration
# Copy to .env and fill in your keys

BAYESLINE_DEBUG=true

# Database (SQLite for dev, PostgreSQL for production)
BAYESLINE_DATABASE_URL=sqlite+aiosqlite:///./bayesline.db

# Prediction Market APIs
# Polymarket (public API, no key needed)
BAYESLINE_POLYMARKET_API_URL=https://clob.polymarket.com
# Manifold (public API, no key needed)
BAYESLINE_MANIFOLD_API_URL=https://api.manifold.markets/v0
# Kalshi (requires API key for authenticated endpoints)
BAYESLINE_KALSHI_API_KEY=

# News APIs
BAYESLINE_NEWSAPI_KEY=          # Get from https://newsapi.org
BAYESLINE_GDELT_API_URL=https://api.gdeltproject.org/api/v2

# LLM for summarization
BAYESLINE_LLM_PROVIDER=anthropic    # "anthropic" or "openai"
BAYESLINE_LLM_MODEL=claude-sonnet-4-5-20250929
BAYESLINE_ANTHROPIC_API_KEY=
BAYESLINE_OPENAI_API_KEY=

# Scoring weights (defaults are good, tune as needed)
# BAYESLINE_MARKET_SIGNAL_WEIGHT=0.45
# BAYESLINE_COVERAGE_GAP_WEIGHT=0.20
# BAYESLINE_CONSEQUENCE_WEIGHT=0.20
# BAYESLINE_TIME_SENSITIVITY_WEIGHT=0.10
# BAYESLINE_MANIPULATION_RISK_PENALTY=0.15
# BAYESLINE_HYPE_GAP_PENALTY=0.10

# Pipeline intervals (seconds)
BAYESLINE_MARKET_POLL_INTERVAL=300
BAYESLINE_NEWS_POLL_INTERVAL=600
